    {"id": "notion", "category": "notes/docs", "source": "npm:@notionhq/notion-mcp-server", "version": "2.5.2",
     "command": "npx", "args": ["-y", "@notionhq/notion-mcp-server@2.5.2"], "env": {"NOTION_TOKEN": "ntn_fake_token_for_tools_list"}},
    {"id": "obsidian", "category": "notes/docs", "source": "pypi:mcp-obsidian", "version": "0.2.3",
     "command": "uvx", "args": ["mcp-obsidian==0.2.3"], "env": {"OBSIDIAN_API_KEY": "fake-token-for-tools-list"}},
    {"id": "atlassian", "category": "tickets/docs", "source": "pypi:mcp-atlassian", "version": "0.23.1",
