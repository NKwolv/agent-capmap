{
  "description": "Real MCP servers in the evaluation set. Versions are pinned to releases at least 14 days old at capture time. Credentials are dummies (they contain 'fake'): tools/list does not need real ones. {sandbox} is replaced by a throwaway directory at capture time.",
  "servers": [
    {"id": "filesystem", "category": "filesystem", "source": "npm:@modelcontextprotocol/server-filesystem", "version": "2026.8.31",
     "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "{sandbox}"]},
    {"id": "desktop-commander", "category": "filesystem+shell", "source": "npm:@wonderwhy-er/desktop-commander", "version": "0.2.52",
     "command": "npx", "args": ["-y", "@wonderwhy-er/desktop-commander@0.2.52"],
     "home_files": {".claude-server-commander/config.json": "{\"telemetryEnabled\": false}"}},
    {"id": "git", "category": "git", "source": "pypi:mcp-server-git", "version": "2026.8.18",
     "command": "uvx", "args": ["mcp-server-git==2026.8.18"]},
    {"id": "github", "category": "git hosting", "source": "npm:@modelcontextprotocol/server-github", "version": "2025.4.8", "deprecated": true,
     "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
     "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": "fake-token-for-tools-list"}},
    {"id": "gitlab", "category": "git hosting", "source": "npm:@modelcontextprotocol/server-gitlab", "version": "2025.4.25", "deprecated": true,
     "command": "npx", "args": ["-y", "@modelcontextprotocol/server-gitlab@2025.4.25"],
     "env": {"GITLAB_PERSONAL_ACCESS_TOKEN": "fake-token-for-tools-list", "GITLAB_API_URL": "https://gitlab.example.com/api/v4"}},
    {"id": "slack", "category": "chat", "source": "npm:@modelcontextprotocol/server-slack", "version": "2025.4.25", "deprecated": true,
     "command": "npx", "args": ["-y", "@modelcontextprotocol/server-slack@2025.4.25"],
     "env": {"SLACK_BOT_TOKEN": "fake-token-for-tools-list", "SLACK_TEAM_ID": "TFAKE0000"}},
    {"id": "fetch", "category": "web fetch", "source": "pypi:mcp-server-fetch", "version": "2026.8.18",
     "command": "uvx", "args": ["mcp-server-fetch==2026.8.18"]},
    {"id": "playwright", "category": "browser", "source": "npm:@playwright/mcp", "version": "0.0.83",
