    {"id": "sentry", "category": "monitoring", "source": "npm:@sentry/mcp-server", "version": "0.41.0",
     "command": "npx", "args": ["-y", "@sentry/mcp-server@0.41.0"], "env": {"SENTRY_ACCESS_TOKEN": "fake-token-for-tools-list"}},
    {"id": "shell-server", "category": "shell", "source": "pypi:mcp-shell-server", "version": "1.1.12",
